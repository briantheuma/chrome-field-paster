{
  "manifest_version": 3,
  "name": "Field Paster",
  "version": "1.0",
  "description": "Store and copy commonly used field values with one click",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Field Paster"
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
   "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
